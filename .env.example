# LLM & Embedding API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
COHERE_API_KEY=your_cohere_api_key_here
JINA_API_KEY=jina_your_jina_api_key_here

# Qdrant Cloud Vector Database
QDRANT_URL=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=univ_hybrid_rag

# LangSmith Observability & Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=UNIV_RBAC_RAG

# Role Portal Passwords
STUDENT_PASSWORD=student123
FACULTY_PASSWORD=faculty123
ADVISOR_PASSWORD=advisor123
DEAN_PASSWORD=dean123
ADMIN_PASSWORD=admin123
